# Normalize text to LF in the repository and in checkouts on every platform, so test
# fixtures and snapshots match byte for byte on Windows too.
* text=auto eol=lf

*.ps1 text eol=crlf
*.iss text eol=crlf
*.bat text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
