    InstallerSha256: @X64_SHA256@
    ProductCode: '{7C1E4B7E-2B7A-4C5B-9C0E-6A1F3D2B9E41}_is1'
  - Architecture: arm64
    InstallerUrl: https://github.com/meetdhruva/lector/releases/download/v@VERSION@/Lector-@VERSION@-windows-arm64-setup.exe
