# Statics that crates/lector-review may declare (ADR 0001), as `NAME: Type`: the name AND the type
# must both match the declaration (whitespace is ignored), so a second static that reuses an allowed
# name, or an allowed static whose type later becomes mutable, is reported. Every `static` needs an
# entry, whatever its type (OnceLock, LazyLock, Mutex, RwLock, atomics, Cell, `static mut`, the
# statics inside `thread_local!` / `lazy_static!`). An entry that matches no static is stale and fails.

# Compiled regex table of the risk signals (crates/lector-review/src/risk/patterns.rs): immutable once built.
RISK_PATTERNS: std::sync::OnceLock<Option<Patterns>>
# Compiled regex table of the content signals (crates/lector-review/src/risk/signals.rs): immutable once built.
SIGNAL_PATTERNS: std::sync::OnceLock<Option<Sigs>>
