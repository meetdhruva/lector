# Where threads may be created (ADR 0003): only the named-thread helper in lector-base (ADR 0005).
# Everything else, the scheduler's own workers included, starts threads through
# lector_base::thread::spawn_named with a kind from the list below. Nothing else may call
# thread::spawn / thread::Builder / spawn_scoped (std::thread::scope inside one call is fine).
crates/lector-base/src/thread.rs

# Closed list of owner-thread kinds for lector_base::thread::spawn_named (ADR 0003, decision 3):
# a thread that is itself a long-lived resource. One entry per `ThreadKind` variant of
# crates/lector-base/src/thread.rs (a unit test there keeps the two lists equal; the spelling is the
# variant's kebab-case name; comparison here ignores case, `-` and `_`). Adding a kind needs an ADR.
kind:pty-reader   # terminal: reads the PTY master
kind:pty-writer   # terminal: writes input to the PTY master
kind:pty-waiter   # terminal: waits for the shell to exit
kind:pty-parser   # terminal: parses PTY output into the grid
kind:lsp-reader   # language server stdout reader
kind:lsp-writer   # language server stdin writer
kind:lsp-watchdog   # language server request-timeout watchdog
kind:askpass-listener   # askpass credential socket accept loop
kind:file-watcher   # file watcher debounce loop
kind:watch-poll   # fallback polling when no watcher could be registered
kind:scheduler-worker   # a lector-app scheduler worker (compute, reserved interactive, blocking lane)
kind:scheduler-timer   # the scheduler's debounce timer
kind:pipe-reader   # pumps a child's stdout/stderr
kind:pipe-writer   # pumps a child's stdin (outlives the spawn call) without deadlocking against full pipes
kind:acp-reader   # agent client: ACP connection reader
kind:picker-worker   # the file picker's matching thread
kind:mock-server   # mock forge server used by tests and examples (test-only, see below; kept here because the lector-base unit test compares this list with ThreadKind::ALL)

# Kinds that only test-support code may spawn (ADR 0010 item 8). `lector_forge::mock` is compiled
# into the library so that integration tests and examples can use it; no production code may
# spawn this kind. The checker fails when a `test-only` kind is spawned outside the `test-file`
# globs, and when either entry matches nothing.
test-only:mock-server   # the mock forge server's accept loop and connections
test-file:crates/lector-forge/src/mock.rs   # the only file that may spawn a test-only kind
